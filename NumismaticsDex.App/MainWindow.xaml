<Window
    x:Class="NumismaticsDex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NumismaticsDex">
    <Border x:Name="RootBorder" Background="{StaticResource PageBackgroundBrush}" Padding="16" RequestedTheme="Light">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="NumismaticsDex" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Left" TextAlignment="Left" />
                <TextBlock x:Name="AppSubtitleText" Text="世界钱币图鉴 @ Kivinsae Fang" Width="180" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" TextAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageSelector" Width="136" Height="36" SelectedIndex="0" SelectionChanged="LanguageSelector_SelectionChanged" AutomationProperties.Name="Display language">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
                    <ComboBoxItem Content="日本語" Tag="ja-JP" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
                <Button x:Name="ThemeButton" Width="36" Height="36" Padding="0" Click="ThemeButton_Click" AutomationProperties.Name="切换到夜间模式">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#x263E;" FontFamily="Segoe UI Symbol" FontSize="18" />
                </Button>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TopSummaryText" Text="演示数据 · 2 个版别" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PageBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        <NavigationView
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="170"
            Background="{StaticResource PageBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="BanknotesNavItem" Content="纸币" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Page" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CoinsNavItem" Content="硬币" IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calculator" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MedalsNavItem" Content="纪念章" IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Favorite" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid ColumnSpacing="12" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="292" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" VerticalAlignment="Top">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CurrentTopicLabel" Text="选择目录层级" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock x:Name="RegionSelectorLabel" Text="洲 / 地区" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="RegionSelector" Height="30" MinHeight="0" FontSize="11" SelectionChanged="RegionSelector_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="2">
                                <TextBlock x:Name="CountrySelectorLabel" Text="国家 / 地区" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="CountrySelector" Height="30" MinHeight="0" FontSize="11" SelectionChanged="CountrySelector_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Spacing="2">
                                <TextBlock x:Name="CollectionSelectorLabel" Text="专题" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="CollectionSelector" Height="30" MinHeight="0" FontSize="11" SelectionChanged="CollectionSelector_SelectionChanged" />
                            </StackPanel>
                            <TextBlock x:Name="CollectionDescriptionText" Grid.Row="4" FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBox
                                x:Name="SearchBox"
                                Grid.Row="5"
                                PlaceholderText="搜索 Pick 号、面值、发行机构"
                                TextChanged="SearchBox_TextChanged" />
                            <ListView
                                x:Name="BanknoteList"
                                Grid.Row="6"
                                ItemsSource="{x:Bind ViewModel.VisibleBanknotes}"
                                SelectionChanged="BanknoteList_SelectionChanged"
                                SelectionMode="Single"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,5" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PickLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Issuer}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Issuer}" />
                                                </Grid>
                                                <TextBlock Text="{Binding VariantCaption}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Denomination}" FontSize="11" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="CountText" Grid.Row="7" Text="2 个版别" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="DetailPick" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="DetailHeading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="DetailDenomination" Grid.Column="1" Margin="0,0,20,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="FrontLabel" Text="正面" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <Image x:Name="FrontImage" Height="148" Stretch="Uniform" AutomationProperties.Name="纸币正面" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="BackLabel" Text="背面" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <Image x:Name="BackImage" Height="148" Stretch="Uniform" AutomationProperties.Name="纸币背面" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="IssueInfoHeading" Text="发行信息" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Name="IssuerLabel" Text="发行机构" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="IssuerText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock x:Name="YearLabel" Text="年份" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="YearText" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock x:Name="IssueDateLabel" Text="日期说明" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="IssueDateText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock x:Name="PrinterLabel" Text="印制机构" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="PrinterText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="DescriptionLabel" Text="描述" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="VariantText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ResearchText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TagsLabel" Text="标签" FontSize="10" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                                        <TextBlock x:Name="TagsText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <Button x:Name="ResearchSourceButton" Content="研究资料来源" HorizontalAlignment="Left" Visibility="Collapsed" Click="ResearchSourceButton_Click" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <Button x:Name="RefreshButton" AutomationProperties.Name="从来源刷新" IsEnabled="False" Click="RefreshFromSource_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                    <TextBlock x:Name="RefreshButtonText" Text="从来源刷新" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel x:Name="RefreshActivityPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                                                <ProgressRing x:Name="RefreshProgressRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                                                <TextBlock x:Name="RefreshStatusText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="SourceButton" Grid.Column="1" Content="查看 banknote.ws 原始记录" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SourceButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        </Border>
    </Grid>
    </Border>
</Window>